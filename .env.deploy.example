# Deployment configuration for aegis-steward
#
# `aegis deploy` copies .env.deploy to the server as its only .env: compose
# fills docker-compose*.yml's ${...} from it and every container loads it.
# So start .env.deploy from a copy of your local .env (API keys, Plaid,
# comms, everything else the app reads) and set or replace the keys below.
#
# IMPORTANT: .env.deploy holds secrets. It is gitignored; never commit it.

#=============================================================================
# SERVER CONNECTION
#=============================================================================

DEPLOY_HOST=your-server-ip
DEPLOY_USER=root
DEPLOY_PATH=/opt/aegis-steward
DOCKER_CONTEXT=aegis-steward-remote

#=============================================================================
# DOMAIN AND TLS (Traefik, Let's Encrypt)
#=============================================================================

# The name the server answers on; its DNS A record points at the server.
# The other domain settings below are built from it.
DOMAIN=steward.example.com
# Let's Encrypt account address. Read when Traefik starts, never committed.
ACME_EMAIL=you@example.com

# Who may open /dashboard, /docs, /redoc, /openapi.json, /health/detailed
# (comma-separated CIDRs). Unset: private networks only, so not you from home.
# ADMIN_IP_ALLOWLIST=203.0.113.7/32

#=============================================================================
# APPLICATION
#=============================================================================

APP_ENV=prod
# Your local .env may turn sign-in off; the server never does (`aegis
# deploy` refuses a file with it off, a dev APP_ENV or no SECRET_KEY).
AUTH_ENABLED=true
AUTO_RELOAD=false
# The public URL and the allowed host follow DOMAIN (stamped by each deploy).
ADMIN_USER_EMAILS=["you@example.com"]

# A new one for the server: openssl rand -hex 32
SECRET_KEY=
# NOT a new one: the SAME ENCRYPTION_KEY your local .env has. Bank tokens,
# account numbers and other sealed columns were encrypted with it, and a
# different key cannot read them back.
ENCRYPTION_KEY=

# /docs, /redoc and /openapi.json ask for these; unset they are 404 in prod.
DOCS_USERNAME=
DOCS_PASSWORD=

#=============================================================================
# PROXY: believe X-Forwarded-For from Traefik only
#=============================================================================

TRUST_PROXY_HEADERS=true
# The compose network pinned in docker-compose.prod.yml, Traefik's.
TRUSTED_PROXIES=["172.28.0.0/24"]

#=============================================================================
# REDIS
#=============================================================================

# openssl rand -hex 32 (hex: it sits inside a URL). Redis refuses to start
# without it in prod; the app reaches Redis through REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

#=============================================================================
# AI
#=============================================================================

# What a fresh database starts on; match the model chosen locally
# (`aegis-steward llm current`). No Ollama runs on the server.
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
OPENAI_API_KEY=

#=============================================================================
# PLAID
#=============================================================================

# Webhooks go to ${PUBLIC_BASE_URL}/api/v1/finance/webhook/plaid on their own.
# Leave PLAID_TUNNEL_METRICS_URL out: it is the dev tunnel, and the guard
# that lets only Plaid's webhook through it is installed only where it is set.
